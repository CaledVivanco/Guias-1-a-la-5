# Copiar este archivo como .env y reemplazar solo los valores marcados.
# .env está excluido por .gitignore. Nunca confirmar credenciales reales.

# TiDB Cloud Starter > Connect
DB_HOST=REPLACE_WITH_TIDB_HOST
DB_PORT=4000
DB_NAME=crud_usuarios
DB_USERNAME=REPLACE_WITH_CLUSTER_PREFIX.root
DB_PASSWORD=REPLACE_WITH_TIDB_GENERATED_PASSWORD
DB_SSL_MODE=VERIFY_IDENTITY

PORT=8080

# Brevo API transaccional. La clave REST empieza por xkeysib-.
# El remitente debe estar verificado en Brevo.
BREVO_API_KEY=xkeysib-REPLACE_WITH_BREVO_API_KEY
BREVO_FROM_ADDRESS=remitente-verificado@example.com
BREVO_FROM_NAME=Gestion de Usuarios

# Parametros opcionales de resiliencia.
BREVO_CONNECT_TIMEOUT=2s
BREVO_READ_TIMEOUT=5s
BREVO_RETRY_MAX_ATTEMPTS=3
BREVO_RETRY_INITIAL_DELAY=500ms
BREVO_RETRY_MULTIPLIER=2.0
BREVO_CIRCUIT_FAILURE_THRESHOLD=50
BREVO_CIRCUIT_WINDOW_SIZE=10
BREVO_CIRCUIT_MINIMUM_CALLS=5
BREVO_CIRCUIT_OPEN_DURATION=30s

# Reemplazar por un secreto aleatorio codificado en Base64.
JWT_SECRET=REPLACE_WITH_A_RANDOM_BASE64_SECRET
JWT_EXPIRATION_SECONDS=900
