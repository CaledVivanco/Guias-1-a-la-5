# Copie este archivo como .env antes de ejecutar Docker Compose.
# Nunca agregue el .env real al repositorio.

DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_LOCAL_ROOT_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
JWT_EXPIRATION_SECONDS=900

BREVO_API_KEY=xkeysib-REPLACE_WITH_BREVO_API_KEY
BREVO_FROM_ADDRESS=remitente-verificado@example.com
BREVO_FROM_NAME=Gestion de Usuarios
